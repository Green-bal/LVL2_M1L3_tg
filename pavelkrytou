bot = telebot.TeleBot(f)

@bot.message_handler(commands=['start'])
def send_welcome(message):
    markup = InlineKeyboardMarkup()
    markup.row_width = 2
    markup.add(
        InlineKeyboardButton("я люблю тюленьчики", callback_data="btn1"),
        InlineKeyboardButton("я не лублу тюленей", callback_data="btn2")
    )
    bot.send_message(message.chat.id, "Ты любищь тюленчиков", reply_markup=markup)

@bot.callback_query_handler(func=lambda message: True)
def callback_query(message):
    if message.data == "btn1":
        bot.send_message(message.chat.id, "ты большой молодец")
    elif message.data == "btn2":
        bot.send_message(message.chat.id, "2 в журнал")
